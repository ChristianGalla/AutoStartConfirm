<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.18362.0</TargetPlatformMinVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <PublishUrl>publish\</PublishUrl>
    <Deterministic>false</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <PublishSingleFile>false</PublishSingleFile>
    <ApplicationIcon>Assets\Icon.ico</ApplicationIcon>
    <AssemblyTitle>Auto Start Confirm</AssemblyTitle>
    <Product>Auto Start Confirm</Product>
    <Copyright>Copyright © 2020 Christian Galla</Copyright>
    <Authors>Christian Galla</Authors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Configurations>Debug Framework Dependent;Release Framework Dependent;Debug Standalone;Release Standalone</Configurations>
    <ProduceReferenceAssembly>True</ProduceReferenceAssembly>
    <!-- MRT Core / ResourceLoader expects the main app's resource index file to be named
         "resources.pri" next to the executable. The Microsoft.Windows.SDK.BuildTools.MSIX
         package no longer applies this naming automatically for WinExe output, so it must
         be set explicitly here to avoid a FileNotFoundException from ResourceLoader at runtime. -->
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
    <!-- Ensures F5 picks up GUI changes from the referenced AutoStartConfirmLib project; VS's
         fast up-to-date check is evaluated per-project, so the startup project also needs this
         disabled to force re-checking/re-copying the library's updated output. -->
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug Framework Dependent|x64'">
    <OutputPath>bin\x64\Debug_FrameworkDependent\</OutputPath>
    <DefineConstants>$(DefineConstants);DEBUG;DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <SelfContained>false</SelfContained>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug Standalone|x64'">
    <OutputPath>bin\x64\Debug_Standalone\</OutputPath>
    <DefineConstants>$(DefineConstants);DEBUG;DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release Framework Dependent|x64'">
    <OutputPath>bin\x64\Release_FrameworkDependent\</OutputPath>
    <DefineConstants>$(DefineConstants);RELEASE;DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <SelfContained>false</SelfContained>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release Standalone|x64'">
    <OutputPath>bin\x64\Release_Standalone\</OutputPath>
    <DefineConstants>$(DefineConstants);RELEASE;DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="Assets\Icon.xcf" />
    <Content Remove="Assets\NotificationIcons.xcf" />
  </ItemGroup>
  <ItemGroup>
    <Page Remove="TrayIconResources.xaml" />
  </ItemGroup>
  <ItemGroup>
    <None Update="nlog.sample.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="nlog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <None Update="Assets\AddIcon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\RemoveIcon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AutoStartConfirmLib\AutoStartConfirmLib.csproj">
      <Private>True</Private>
      <CopyLocalSatelliteAssemblies>False</CopyLocalSatelliteAssemblies>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <Content Update="Assets\Icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <DataFiles Include="$(ProjectDir)\nlog.sample.config" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <DataFiles Include="..\LICENSE" />
  </ItemGroup>
  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="If Not Exist $(ProjectDir)nlog.config (Copy $(ProjectDir)nlog.sample.config $(ProjectDir)nlog.config)" />
  </Target>
  <Target Name="RemoveFoldersWithMuiFilesAfterBuild" AfterTargets="PostBuildEvent">
    <ItemGroup>
      <RemovingFiles Include="$(OutDir)*\*.mui" Exclude="$(OutDir)en-US\*.mui;$(OutDir)de-DE\*.mui" />
      <RemovingFiles Include="$(OutDir)*\Microsoft.Win32.TaskScheduler.resources.dll" Exclude="$(OutDir)de\Microsoft.Win32.TaskScheduler.resources.dll" />
      <RemovingFolders Include="@(RemovingFiles->'%(RootDir)%(Directory)')" />
    </ItemGroup>
    <RemoveDir Directories="@(RemovingFolders)" />
  </Target>
  <Target Name="CustomActionsAfterPublish" AfterTargets="Publish">
    <ItemGroup>
      <RemovingFiles Include="$(PublishDir)*\*.mui" Exclude="$(PublishDir)en-US\*.mui;$(PublishDir)de-DE\*.mui" />
      <RemovingFiles Include="$(PublishDir)*\Microsoft.Win32.TaskScheduler.resources.dll" Exclude="$(PublishDir)de\Microsoft.Win32.TaskScheduler.resources.dll" />
      <RemovingFolders Include="@(RemovingFiles->'%(RootDir)%(Directory)')" />
    </ItemGroup>
    <RemoveDir Directories="@(RemovingFolders)" />
  </Target>
  <!-- GenerateAssemblyInfo is false (see above) because AssemblyInfo.cs already hand-authors several
       attributes (AssemblyTitle, AssemblyProduct, etc.) that would otherwise collide with the SDK's
       auto-generated ones. AssemblyInfo.cs itself is a static, non-regenerated file, so it cannot hold
       an up-to-date AssemblyVersion sourced from the centralized $(AssemblyVersion) property (see
       Directory.Build.props). This target regenerates just the AssemblyVersion attribute on every
       build, independent of GenerateAssemblyInfo, so it always reflects the current version. -->
  <Target Name="GenerateAssemblyVersionAttribute" BeforeTargets="CoreCompile">
    <ItemGroup>
      <AssemblyVersionAttribute Include="System.Reflection.AssemblyVersionAttribute">
        <_Parameter1>$(AssemblyVersion)</_Parameter1>
      </AssemblyVersionAttribute>
    </ItemGroup>
    <WriteCodeFragment Language="C#" OutputDirectory="$(IntermediateOutputPath)" AssemblyAttributes="@(AssemblyVersionAttribute)">
      <Output TaskParameter="OutputFile" ItemName="Compile" />
      <Output TaskParameter="OutputFile" ItemName="FileWrites" />
    </WriteCodeFragment>
  </Target>
</Project>
